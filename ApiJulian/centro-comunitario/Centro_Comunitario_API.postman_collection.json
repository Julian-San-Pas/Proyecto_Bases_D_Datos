              "raw": "{\n  \"nombreCompleto\": \"María García López\",\n  \"documentoIdentificacion\": \"1234567890\",\n  \"edad\": 28,\n  \"correoElectronico\": \"maria.garcia@email.com\",\n  \"numerTelefono\": \"3001234567\",\n  \"direccionResidencia\": \"Calle 50 #30-20, Medellín\",\n  \"rol\": \"PARTICIPANTE\",\n  \"contrasena\": \"password123\"\n}"
