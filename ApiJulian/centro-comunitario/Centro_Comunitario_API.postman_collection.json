    "_postman_id": "centro-comunitario-2024"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "usuario_id", "value": "" },
    { "key": "actividad_id", "value": "" },
    { "key": "sesion_id", "value": "" },
    { "key": "inscripcion_id", "value": "" },
    { "key": "programa_id", "value": "" },
    { "key": "evaluacion_id", "value": "" },
    { "key": "anuncio_id", "value": "" },
    { "key": "foro_id", "value": "" }
